rules_version = '2';
// NoLongerUbiquitous の Firestore の決まり (docs/online.md)
// users/{uid}/...: 本人だけが読み書きできる (クラウドのセーブ・自作の国・名前)
// rooms/{code}: ネット対戦の部屋。ログインした人なら読める。作る・変える・消すのはホストだけ
// rooms/{code}/seats/{pi}: 席。ホストが招待 (offer) を書き、参加者が席を取って返事 (answer) を書く。取られた席は、取った人とホストしか書けない
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.host == request.auth.uid;
      function isHost() { return get(/databases/$(database)/documents/rooms/$(code)).data.host == request.auth.uid; }
      match /seats/{pi} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && isHost();
        allow update: if request.auth != null && (isHost()
          || ((!('uid' in resource.data) || resource.data.uid == request.auth.uid) && request.resource.data.uid == request.auth.uid));
      }
    }
  }
}
