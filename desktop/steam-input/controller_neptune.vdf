	"controller_type"		"controller_neptune"
	"localization"
	{
		"english"
		{
			"title"		"NoLongerUbiquitous (keyboard & mouse)"
			"description"		"Right trackpad moves the cursor; R2 clicks and drags the map, L2 issues fleet orders. Left stick zooms; hold L4 while dragging for box selection. D-pad and bumpers rotate and tilt the map. A pauses, B goes back."
		}
		"japanese"
		{
			"title"		"NoLongerUbiquitous (キーボードとマウス)"
			"description"		"右トラックパッドでカーソル。R2 で選ぶ・押したまま動かすと地図が動く。L2 で艦隊を動かす。左スティックで拡大縮小、L4 を押したままドラッグで範囲選択。十字キーと L1・R1 で地図を回す・傾ける。A で止める、B で戻る。"
		}
	}
