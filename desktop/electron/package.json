{
  "name": "nolongerubiquitous-electron",
  "private": true,
  "version": "0.0.1",
  "description": "NoLongerUbiquitous を Electron で包む",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . NoLongerUbiquitous --out=out --overwrite --asar --extra-resource=../game --extra-resource=../bench/probe.js --ignore=^/out",
    "package:linux": "npm run package -- --platform=linux --arch=x64",
    "package:win": "npm run package -- --platform=win32 --arch=x64"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@fontsource/zen-antique": "5.3.1",
    "@fontsource/zen-old-mincho": "5.3.1",
    "electron": "44.8.0"
  }
}
